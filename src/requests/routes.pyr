###env
import requests
BASE = "http://localhost:8000/api"

COOKIE = "better-auth.session_token=5e8wTBXUEnJnDmSbkbJGKyyJrhvqLLVh.4twIB6PzYKQq8RMP%2Be1VfYIcsqdHAlMlSWzW0fyvPtQ%3D"
H = {"Cookie": COOKIE, "Origin": "http://localhost:8000"}

WORKOUT_ID = 1
DIVISION_ID = 4
EXERCISE_ID = 3
LOGBOOK_ID = 3
HISTORICAL_ID = 19
JOB_ID = 6
###env


# ============================================================
# AUTH
# ============================================================

requests.post(f"{BASE}/auth/sign-up/email", json={"name": "teste", "email": "teste@teste.com", "password": "1234" })

requests.post(f"{BASE}/auth/sign-in/email", json={"email": "teste@teste.com", "password": "1234" })

requests.post(f"{BASE}/auth/sign-out", headers=H)

requests.get(f"{BASE}/auth/get-session", headers=H)


# ============================================================
# WORKOUTS
# ============================================================

requests.get(f"{BASE}/workouts", params={"page": 1, "limit": 10}, headers=H)

requests.get(f"{BASE}/workouts/{WORKOUT_ID}", headers=H)

requests.post(f"{BASE}/workouts", json={"name": "teste workout"}, timeout=5, headers=H)

requests.delete(f"{BASE}/workouts/{WORKOUT_ID}", headers=H)


# ============================================================
# DIVISIONS
# ============================================================

requests.get(f"{BASE}/divisions?workoutId={WORKOUT_ID}", params={"page": 1, "limit": 10}, headers=H)

requests.get(f"{BASE}/divisions/{DIVISION_ID}?workoutId={WORKOUT_ID}", headers=H)

requests.post(f"{BASE}/divisions", json={"name": "legs", "day": "wednesday", "workoutId": WORKOUT_ID}, headers=H)

requests.delete(f"{BASE}/divisions/{DIVISION_ID}?workoutId={WORKOUT_ID}", headers=H)


# ============================================================
# EXERCISES
# ============================================================

requests.get(f"{BASE}/exercises?workoutId={WORKOUT_ID}&divisionId={DIVISION_ID}", params={"page": 1, "limit": 10}, headers=H)

requests.get(f"{BASE}/exercises/{EXERCISE_ID}?workoutId={WORKOUT_ID}&divisionId={DIVISION_ID}", headers=H)

requests.post(f"{BASE}/exercises?workoutId={WORKOUT_ID}", json={
	"name": "Bench press", 
	"target_muscle_group": "Chest", 
	"series_reps": "2x8", 
	"rest": 120,
	"divisionId": DIVISION_ID
	}, headers=H)

requests.delete(f"{BASE}/exercises/{EXERCISE_ID}?workoutId={WORKOUT_ID}&divisionId={DIVISION_ID}", headers=H)


# ============================================================
# LOGBOOKS
# ============================================================

requests.get(f"{BASE}/logbooks?workoutId={WORKOUT_ID}", headers=H)

requests.get(f"{BASE}/logbooks/{LOGBOOK_ID}?workoutId={WORKOUT_ID}", headers=H)

requests.post(f"{BASE}/logbooks?workoutId={WORKOUT_ID}", json={
	"exerciseId": EXERCISE_ID, 
	"topset_weight": 50, 
	"topset_reps": 8,
	}, headers=H)

requests.post(f"{BASE}/synclogbooks?workoutId={WORKOUT_ID}", json={
	"exercises": [3, 2, 4]
	}, headers=H)

requests.get(f"{BASE}/logbooksjobs/{JOB_ID}", headers=H)

requests.delete(f"{BASE}/logbooks/{LOGBOOK_ID}?workoutId={WORKOUT_ID}", headers=H)


# ============================================================
# HISTORICALS
# ============================================================

requests.get(f"{BASE}/historicals?workoutId={WORKOUT_ID}", params={"search": ""}, headers=H)

requests.get(f"{BASE}/historicals/{HISTORICAL_ID}?workoutId={WORKOUT_ID}", headers=H)

requests.delete(f"{BASE}/historicals/{HISTORICAL_ID}?workoutId={WORKOUT_ID}", headers=H)
