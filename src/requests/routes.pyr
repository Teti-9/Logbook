###env
import requests
BASE = "http://localhost:8000/api"

COOKIE = "better-auth.session_token=PASTE COOKIE FROM SIGN-IN"
H = {"Cookie": COOKIE, "Origin": "http://localhost:8000"}

WORKOUT_ID = 1
DIVISION_ID = 1
EXERCISE_ID = 1
LOGBOOK_ID = 1
HISTORICAL_ID = 1
JOB_ID = 1
###env


# ============================================================
# AUTH
# ============================================================

requests.post(f"{BASE}/auth/sign-up/email", json={"name": "teste", "email": "teste@teste.com", "password": "1234" })

requests.post(f"{BASE}/auth/sign-in/email", json={"email": "teste@teste.com", "password": "1234" })

requests.post(f"{BASE}/auth/sign-out", headers=H)

requests.get(f"{BASE}/auth/get-session", headers=H)


# ============================================================
# WORKOUTS
# ============================================================

requests.get(f"{BASE}/workouts", params={"page": 1, "limit": 10}, headers=H)

requests.get(f"{BASE}/workouts/{WORKOUT_ID}", headers=H)

requests.post(f"{BASE}/workouts", json={"name": "Main workout"}, timeout=5, headers=H)

requests.delete(f"{BASE}/workouts/{WORKOUT_ID}", headers=H)


# ============================================================
# DIVISIONS
# ============================================================

requests.get(f"{BASE}/divisions", params={"page": 1, "limit": 10}, headers=H)

requests.get(f"{BASE}/divisions/{DIVISION_ID}", headers=H)

requests.post(f"{BASE}/divisions", json={"name": "Push", "day": "Monday", "workoutId": WORKOUT_ID}, headers=H)

requests.delete(f"{BASE}/divisions/{DIVISION_ID}", headers=H)


# ============================================================
# EXERCISES
# ============================================================

requests.get(f"{BASE}/exercises", params={"page": 1, "limit": 10}, headers=H)

requests.get(f"{BASE}/exercises/{EXERCISE_ID}", headers=H)

requests.post(f"{BASE}/exercises", json={
	"name": "Bench press", 
	"target_muscle_group": "Chest", 
	"series_reps": "2x8", 
	"rest": 120,
	"divisionId": DIVISION_ID
	}, headers=H)

requests.delete(f"{BASE}/exercises/{EXERCISE_ID}", headers=H)


# ============================================================
# LOGBOOKS
# ============================================================

requests.get(f"{BASE}/logbooks", headers=H)

requests.get(f"{BASE}/logbooks/{LOGBOOK_ID}", headers=H)

requests.post(f"{BASE}/logbooks", json={
	"exerciseId": EXERCISE_ID, 
	"topset_weight": 50, 
	"topset_reps": 8,
	}, headers=H)

requests.post(f"{BASE}/synclogbooks", json={
	"exercises": [1, 2]
	}, headers=H)

requests.get(f"{BASE}/logbooksjobs/{JOB_ID}", headers=H)

requests.delete(f"{BASE}/logbooks/{LOGBOOK_ID}", headers=H)


# ============================================================
# HISTORICALS
# ============================================================

requests.get(f"{BASE}/historicals", headers=H)

requests.get(f"{BASE}/historicals", params={"search": "supino"}, headers=H)

requests.get(f"{BASE}/historicals/{HISTORICAL_ID}", headers=H)

requests.delete(f"{BASE}/historicals/{HISTORICAL_ID}", headers=H)
