// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Workout {
  id          Int          @id @default(autoincrement())
  name        String
  observation String?
  userId      Int
  user        User         @relation(fields: [userId], references: [id])
  divisions   Division[]
  exercises   Exercises[]
  logbooks    Logbook[]
  historicals Historical[]
  isDeleted   Boolean      @default(false)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, isDeleted])
}

enum Day {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

model Division {
  id          Int          @id @default(autoincrement())
  name        String
  day         Day
  userId      Int
  user        User         @relation(fields: [userId], references: [id])
  workoutId   Int
  workout     Workout      @relation(fields: [workoutId], references: [id])
  exercises   Exercises[]
  logbooks    Logbook[]
  historicals Historical[]
  isDeleted   Boolean      @default(false)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, day, isDeleted])
  @@index([workoutId])
}

enum AdvancedTechnique {
  backoff
}

model Exercises {
  id                  Int                @id @default(autoincrement())
  name                String
  target_muscle_group String
  series_reps         String
  rest                Int
  advanced_technique  AdvancedTechnique?
  observation         String?
  userId              Int
  user                User               @relation(fields: [userId], references: [id])
  workoutId           Int
  workout             Workout            @relation(fields: [workoutId], references: [id])
  divisionId          Int
  division            Division           @relation(fields: [divisionId], references: [id])
  logbooks            Logbook[]
  historicals         Historical[]
  isDeleted           Boolean            @default(false)
  deletedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([userId, divisionId, isDeleted])
  @@index([workoutId])
}

model ExerciseCatalog {
  id                  Int       @id @default(autoincrement())
  name                String
  target_muscle_group String
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([name])
  @@map("Exercises__")
}

model Logbook {
  id            Int          @id @default(autoincrement())
  topset_weight Float
  topset_reps   Int
  extra         String?
  sync          Boolean      @default(false)
  userId        Int
  user          User         @relation(fields: [userId], references: [id])
  workoutId     Int
  workout       Workout      @relation(fields: [workoutId], references: [id])
  divisionId    Int
  division      Division     @relation(fields: [divisionId], references: [id])
  exerciseId    Int
  exercise      Exercises    @relation(fields: [exerciseId], references: [id])
  historicals   Historical[]
  isDeleted     Boolean      @default(false)
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, exerciseId, isDeleted])
}

model Historical {
  id                     Int       @id @default(autoincrement())
  previous_topset_weight Float
  previous_topset_reps   Int
  extra                  String?
  userId                 Int
  user                   User      @relation(fields: [userId], references: [id])
  workoutId              Int
  workout                Workout   @relation(fields: [workoutId], references: [id])
  divisionId             Int
  division               Division  @relation(fields: [divisionId], references: [id])
  exerciseId             Int
  exercise               Exercises @relation(fields: [exerciseId], references: [id])
  logbookId              Int
  logbook                Logbook   @relation(fields: [logbookId], references: [id])
  isDeleted              Boolean   @default(false)
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId, exerciseId, isDeleted])
  @@index([logbookId])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  replacedBy String?

  @@index([userId])
  @@index([tokenHash])
}

model Session {
  id        Int      @id @default(autoincrement())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    Int       @id @default(autoincrement())
  accountId             String
  providerId            String
  userId                Int
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model User {
  id       Int     @id @default(autoincrement())
  name     String  @default("Member")
  email    String  @unique
  password String?
  image    String?

  emailVerified Boolean   @default(false)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions    Session[]
  accounts    Account[]
  divisions   Division[]
  exercises   Exercises[]
  logbooks    Logbook[]
  historicals Historical[]
  tokens      RefreshToken[]
  workouts    Workout[]
}
